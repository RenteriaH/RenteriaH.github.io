---
/**
 * CV en HTML: misma fuente que los PDF (src/data/cv.mjs), versión principal A (Software Engineer).
 * Una columna, texto seleccionable y secciones convencionales.
 */
import type { Locale } from '../i18n/ui';
import * as cv from '../data/cv.mjs';

type Txt = Record<Locale, string>;
type CvProject = { name: string | Txt; tag: Txt; stack: string; link?: (l: Locale) => { label: string; href: string }; bullets: Record<Locale, string[]> };
const { variants, links, t: T } = cv;
const maha = cv.maha as Record<string, Txt>;
const projects = cv.projects as Record<string, CvProject>;
const skills = cv.skills as Record<string, Txt>;

interface Props {
  lang: Locale;
  variant?: 'A' | 'B' | 'C' | 'D' | 'E';
}
const { lang, variant = 'A' } = Astro.props;
const v = variants[variant];
const L = T[lang];
const pick = (x: string | Txt) => (typeof x === 'string' ? x : x[lang]);
const bare = (u: string) => u.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<article class="cv">
  <header class="cv__head">
    <p class="cv__name">Guillermo Rentería Hernández</p>
    <p class="cv__title">{v.headline[lang]}</p>
    <p class="cv__contact">
      {L.location} · <a href={`mailto:${links.email}`}>{links.email}</a> · <a href={links.portfolio[lang]}>renteriah.github.io</a> · <a href={links.github}>{bare(links.github)}</a> ·
      <a href={links.linkedin}>{bare(links.linkedin)}</a>
    </p>
  </header>

  <section><h2>{L.h.summary}</h2><p>{v.summary[lang]}</p></section>

  <section>
    <h2>{L.h.skills}</h2>
    <ul class="cv__skills">
      {(v.skills as string[][]).map(([k, s]) => <li><strong>{skills[k][lang]}:</strong> {s}</li>)}
    </ul>
  </section>

  <section>
    <h2>{L.h.exp}</h2>
    <div class="cv__item">
      <div class="cv__row"><h3>{L.job.title} — {L.job.org}</h3><span>{L.job.period}</span></div>
      <p class="cv__meta">{L.job.meta}</p>
      <ul>{v.maha.map((k: string) => <li>{maha[k][lang]}</li>)}</ul>
    </div>
  </section>

  <section>
    <h2>{L.h.proj}</h2>
    {
      v.projects.map((id: string) => {
        const p = projects[id];
        const link = p.link?.(lang);
        return (
          <div class="cv__item">
            <div class="cv__row">
              <h3>{pick(p.name)} <span class="cv__tag">— {p.tag[lang]}</span></h3>
              {link && <a href={link.href}>{link.label}</a>}
            </div>
            <p class="cv__meta">{p.stack}</p>
            <ul>{p.bullets[lang].map((b: string) => <li>{b}</li>)}</ul>
          </div>
        );
      })
    }
  </section>

  <section>
    <h2>{L.h.edu}</h2>
    {L.edu.map(([d, s, p]: string[]) => <div class="cv__row"><p><strong>{d}</strong> — {s}</p><span>{p}</span></div>)}
    <p class="cv__langs"><strong>{L.langs[0]}:</strong> {L.langs[1]}</p>
  </section>
</article>

<style>
  .cv,
  .cv * {
    font-family: Arial, Helvetica, sans-serif !important;
    letter-spacing: normal !important;
    text-wrap: wrap !important;
  }
  .cv {
    max-width: 50rem;
    margin-inline: auto;
    background: var(--surface);
    color: var(--ink);
    padding: clamp(1.25rem, 1rem + 2vw, 3rem);
    border: 1px solid var(--rule);
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .cv .cv__name {
    font-weight: 700;
    font-size: 1.9rem;
    margin: 0;
  }
  .cv__title {
    font-weight: 700;
    margin: 0.25rem 0;
  }
  .cv__contact,
  .cv__meta {
    font-size: 0.86rem;
    color: var(--muted);
    margin: 0 0 0.3rem;
  }
  .cv h2 {
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.2rem;
    margin: 1.3rem 0 0.6rem;
  }
  .cv h3 {
    font-size: 1rem;
    margin: 0.7rem 0 0.1rem;
  }
  .cv ul {
    margin: 0.2rem 0 0;
    padding-left: 1.1rem;
  }
  .cv li + li {
    margin-top: 0.15rem;
  }
  .cv__proj {
    margin: 0.15rem 0 0;
  }
  .cv__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 1rem;
  }
  .cv__row p {
    margin: 0.15rem 0;
  }
  .cv__row > span,
  .cv__row > a {
    font-size: 0.86rem;
    white-space: nowrap;
  }
  .cv__tag {
    font-weight: 400;
  }
  .cv__skills {
    list-style: none;
    padding-left: 0 !important;
  }
  @media print {
    .cv {
      border: 0;
      padding: 0;
      max-width: none;
      font-size: 9.1pt;
      line-height: 1.28;
    }
    .cv .cv__name {
    font-weight: 700; font-size: 17pt; }
    .cv h2 { margin: 0.8rem 0 0.35rem; }
    .cv h3 { margin: 0.45rem 0 0.05rem; }
  }
</style>
