---
import Ledger from './Ledger.astro';
import Evidence from './Evidence.astro';
import { t, localePath, type Locale } from '../i18n/ui';
import { projects, experience, education, skills, person } from '../data/profile';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const es = lang === 'es';
const caseHref = (slug: string) => localePath(lang, es ? `/casos/${slug}/` : `/cases/${slug}/`);
const cvPdf = es ? '/cv/Guillermo_Renteria_CV_ES.pdf' : '/cv/Guillermo_Renteria_CV_EN.pdf';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero__text">
    <p class="mono muted hero__kicker">{t(lang, 'hero.kicker')}</p>
    <h1 id="hero-title">{t(lang, 'hero.title')}</h1>
    <p class="hero__lede">{t(lang, 'hero.lede')}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href={caseHref('saneamiento-gymwarrior')}>{t(lang, 'hero.ctaWork')}</a>
      <a class="btn" href={cvPdf}>{t(lang, 'hero.ctaCv')}</a>
    </div>
    <ul class="hero__links mono">
      <li><a href={person.github} rel="me">GitHub</a></li>
      <li><a href={person.linkedin} rel="me">LinkedIn</a></li>
    </ul>
  </div>
  <div class="hero__ledger">
    <Ledger lang={lang} />
  </div>
</section>

<section class="section" id="trabajo" aria-labelledby="work-title">
  <div class="wrap section__grid">
    <p class="section__label">{t(lang, 'nav.work')}</p>
    <div>
      <h2 id="work-title">{t(lang, 'work.title')}</h2>
      <p class="muted">{t(lang, 'work.intro')}</p>
      <details class="legend">
        <summary class="mono">{t(lang, 'evidence.legend')}</summary>
        <p>{t(lang, 'evidence.legendText')}</p>
      </details>
      <ol class="projects">
        {
          projects.map((p) => (
            <li class:list={["project", { "project--verified": p.evidence.includes("verified") }]}>
              <article aria-labelledby={`p-${p.id}`}>
                <div class="project__head">
                  <h3 id={`p-${p.id}`}>{p.title[lang]}</h3>
                  <Evidence lang={lang} kinds={p.evidence} />
                </div>
                <p class="project__one">{p.oneLiner[lang]}</p>
                <dl class="project__dl">
                  <div>
                    <dt>{es ? 'Problema' : 'Problem'}</dt>
                    <dd>{p.problem[lang]}</dd>
                  </div>
                  <div>
                    <dt>{es ? 'Solución' : 'Solution'}</dt>
                    <dd>{p.solution[lang]}</dd>
                  </div>
                  <div>
                    <dt>{t(lang, 'work.myRole')}</dt>
                    <dd>{p.role[lang]}</dd>
                  </div>
                  <div>
                    <dt>{t(lang, 'work.status')}</dt>
                    <dd>{p.status[lang]}</dd>
                  </div>
                </dl>
                <ul class="project__facts">
                  {p.facts[lang].map((f) => <li>{f}</li>)}
                </ul>
                <ul class="chips" aria-label={t(lang, 'case.stack')}>
                  {p.stack.map((s) => <li>{s}</li>)}
                </ul>
                <p class="project__foot">
                  {p.caseSlug ? (
                    <a href={caseHref(p.caseSlug)}>{t(lang, 'work.readCase')} →</a>
                  ) : p.repo ? (
                    <a href={p.repo}>GitHub →</a>
                  ) : (
                    <span class="mono muted">{t(lang, 'work.privateNote')}</span>
                  )}
                </p>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<section class="section" id="experiencia" aria-labelledby="exp-title">
  <div class="wrap section__grid">
    <p class="section__label">{t(lang, 'nav.experience')}</p>
    <div>
      <h2 id="exp-title">{t(lang, 'exp.title')}</h2>
      {
        experience.map((job) => (
          <article class="job">
            <p class="mono muted job__meta">
              {job.period[lang]} · {job.place[lang]}
            </p>
            <h3>
              {job.title[lang]} — {job.org}
            </h3>
            <ul class="job__list">
              {job.bullets[lang].map((b) => <li>{b}</li>)}
            </ul>
            <ul class="chips">
              {job.stack.map((s) => <li>{s}</li>)}
            </ul>
            {job.caseSlug && (
              <p class="job__case">
                <a href={caseHref(job.caseSlug)}>{t(lang, 'work.readCase')} →</a>
              </p>
            )}
          </article>
        ))
      }
      <h3 class="edu-title">{t(lang, 'edu.title')}</h3>
      <ul class="edu">
        {
          education.map((e) => (
            <li>
              <span class="edu__degree">{e.degree[lang]}</span>
              <span class="muted"> · {e.school}</span>
              <span class="mono muted edu__period">{e.period[lang]}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section class="section" id="tecnologias" aria-labelledby="skills-title">
  <div class="wrap section__grid">
    <p class="section__label">{t(lang, 'nav.skills')}</p>
    <div>
      <h2 id="skills-title">{t(lang, 'skills.title')}</h2>
      <p class="muted skills__intro">{t(lang, 'skills.intro')}</p>
      <div class="skills">
        {
          (['prod', 'proj', 'acad'] as const).map((k) => (
            <section class={`skills__group skills__group--${k}`} aria-labelledby={`sk-${k}`}>
              <h3 id={`sk-${k}`} class="mono">
                {t(lang, `skills.${k}`)}
              </h3>
              <ul class="chips">
                {skills[k].map((s) => <li>{s}</li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="section" id="sobre-mi" aria-labelledby="about-title">
  <div class="wrap section__grid">
    <p class="section__label">{t(lang, 'nav.about')}</p>
    <div class="prose">
      <h2 id="about-title">{t(lang, 'about.title')}</h2>
      {
        es ? (
          <>
            <p>
              Vivo en Torreón, Coahuila. Estudié el bachillerato técnico en Electrónica y ahora curso Ingeniería en Sistemas
              Computacionales en el Instituto Tecnológico de La Laguna, donde hago mi residencia profesional.
            </p>
            <p>
              Me interesa el trabajo que no se ve: que dos sistemas se entiendan, que un dato llegue completo, que un cambio en
              producción se pueda deshacer. En la residencia aprendí que el error casi nunca está donde aparece y que un número
              que nadie contó no es un dato.
            </p>
            <p>
              Trabajo mucho con agentes de IA y los trato como a un equipo que necesita reglas claras: permisos, verificación y
              alguien que revise. Estoy mejorando mi inglés.
            </p>
          </>
        ) : (
          <>
            <p>
              I live in Torreón, Coahuila, in northern Mexico. I completed a technical high-school program in Electronics and I’m
              now studying Computer Systems Engineering at Instituto Tecnológico de La Laguna, where I’m doing my professional internship.
            </p>
            <p>
              I care about the work nobody sees: two systems understanding each other, data arriving complete, a production
              change that can be undone. My internship taught me that the bug is rarely where it shows up, and that a number
              nobody counted isn’t data.
            </p>
            <p>
              I work a lot with AI agents and treat them like a team that needs clear rules: permits, verification and someone
              who reviews. I’m actively improving my English.
            </p>
          </>
        )
      }
    </div>
  </div>
</section>

<section class="section" id="contacto" aria-labelledby="contact-title">
  <div class="wrap section__grid">
    <p class="section__label">{t(lang, 'nav.contact')}</p>
    <div>
      <h2 id="contact-title">{t(lang, 'contact.title')}</h2>
      <p class="contact__text">{t(lang, 'contact.text')}</p>
      <ul class="contact__list">
        {person.email && (
          <li>
            <span class="mono muted">{es ? 'Correo' : 'Email'}</span> <span>{person.email}</span>
          </li>
        )}
        <li><span class="mono muted">LinkedIn</span> <a href={person.linkedin} rel="me">{person.linkedin.replace('https://www.', '')}</a></li>
        <li><span class="mono muted">GitHub</span> <a href={person.github} rel="me">{person.github.replace('https://', '')}</a></li>
        <li><span class="mono muted">CV</span> <a href={localePath(lang, '/cv/')}>{t(lang, 'cv.title')}</a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 2rem + 4vw, 6rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .hero__kicker {
    margin-bottom: 1rem;
  }
  .hero h1 {
    max-width: 18ch;
  }
  .hero__lede {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 38rem;
    color: var(--ink);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .hero__links {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }
  .hero__links a {
    display: inline-block;
    padding-block: 0.5rem;
  }

  .legend {
    margin: 0 0 2rem;
    max-width: var(--measure);
  }
  .legend summary {
    cursor: pointer;
    color: var(--link);
    padding-block: 0.4rem;
  }
  .legend p {
    font-size: var(--step--1);
    margin-top: 0.4rem;
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .project article {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
  }
  .project--verified article {
    border-color: var(--verified);
    border-width: 1.5px;
  }
  .project__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .project__head h3 {
    margin: 0;
  }
  .project__one {
    font-size: var(--step-1);
    line-height: 1.45;
    margin: 0.6rem 0 1rem;
  }
  .project__dl {
    display: grid;
    gap: 0.75rem 2rem;
    margin: 0 0 1rem;
  }
  @media (min-width: 46rem) {
    .project__dl {
      grid-template-columns: 1fr 1fr;
    }
  }
  .project__dl dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
  }
  .project__dl dd {
    margin: 0.15rem 0 0;
    font-size: var(--step--1);
    line-height: 1.55;
  }
  .project__facts {
    margin: 0 0 1rem;
    padding-left: 1.2em;
    font-size: var(--step--1);
  }
  .project__foot {
    margin: 1rem 0 0;
  }
  .project__foot a {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .job + .job {
    margin-top: 2.5rem;
  }
  .job__meta {
    margin: 0 0 0.3rem;
  }
  .job__list {
    max-width: var(--measure);
    padding-left: 1.2em;
  }
  .job__list li + li {
    margin-top: 0.4em;
  }
  .job__case {
    margin-top: 1rem;
  }
  .edu-title {
    margin-top: 3rem;
  }
  .edu {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .edu li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .edu__degree {
    font-family: var(--font-display);
    font-weight: 600;
  }
  .edu__period {
    margin-left: auto;
  }

  .skills__intro {
    max-width: var(--measure);
  }
  .skills {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .skills__group h3 {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.7rem;
  }
  .skills__group--prod h3 {
    color: var(--verified);
  }
  .skills__group--proj h3 {
    color: var(--ai);
  }
  .skills__group--acad h3 {
    color: var(--muted);
  }

  .contact__text {
    max-width: var(--measure);
  }
  .contact__list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  .contact__list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    align-items: baseline;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--rule);
  }
  .contact__list .mono {
    min-width: 5.5rem;
  }
  .contact__list a {
    overflow-wrap: anywhere;
  }
</style>
