---
import Base from '../../../layouts/Base.astro';
import Resume from '../../../components/Resume.astro';
import CvDownloads from '../../../components/CvDownloads.astro';
import { t } from '../../../layouts/../i18n/ui';
---

<Base lang="en" path="/cv/" title={t('en', 'cv.title')}>
  <div class="wrap cv-page">
    <CvDownloads lang="en" />
    <Resume lang="en" />
  </div>
</Base>

<style>
  .cv-page {
    padding-block: 2rem 4rem;
  }
  .cv-page__bar {
    max-width: 50rem;
    margin: 0 auto 1rem;
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.skip),
    .cv-page__bar {
      display: none !important;
    }
    .cv-page {
      padding: 0;
    }
  }
</style>
