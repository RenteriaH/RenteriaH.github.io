---
import Base from '../layouts/Base.astro';
---

<Base lang="es" path="/404/" title="Página no encontrada / Page not found" noindex>
  <section class="wrap nf">
    <h1>Esta página no existe</h1>
    <p>Puede que el enlace esté mal escrito. <a href="/">Volver al inicio</a>.</p>
    <p lang="en" class="muted">This page doesn’t exist. <a href="/en/">Go to the English home page</a>.</p>
  </section>
</Base>

<style>
  .nf {
    padding-block: 5rem;
  }
</style>
