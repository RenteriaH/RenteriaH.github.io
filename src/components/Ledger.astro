---
import { t, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const es = lang === 'es';

// Ilustración del protocolo de escritura. Valores de ejemplo, no datos reales de ningún sistema.
const rows = [
  { op: es ? 'leer' : 'read', detail: 'product-card.liquid  sha 3f9a…', ok: 'ok' },
  { op: es ? 'comparar' : 'compare', detail: es ? 'esperada = actual' : 'expected = current', ok: 'ok' },
  { op: es ? 'escribir' : 'write', detail: es ? 'solo si no cambió' : 'only if unchanged', ok: '200' },
  { op: es ? 'releer' : 'read back', detail: 'sha 7c21…  = sha 7c21…', ok: 'ok' },
];
---

<figure class="ledger" aria-labelledby="ledger-cap">
  <div class="ledger__bar">
    <span class="mono">{t(lang, 'ledger.title')}</span>
    <span class="mono ledger__note">{es ? 'ilustración' : 'illustration'}</span>
  </div>
  <ol class="ledger__rows">
    {
      rows.map((r, i) => (
        <li style={`--i:${i}`}>
          <span class="ledger__op">{r.op}</span>
          <span class="ledger__detail">{r.detail}</span>
          <span class="ledger__ok">{r.ok}</span>
        </li>
      ))
    }
  </ol>
  <p class="ledger__done mono" style={`--i:${rows.length}`}>
    <span aria-hidden="true">✓</span>{' '}
    {es ? 'escritura verificada' : 'write verified'}
  </p>
  <figcaption id="ledger-cap">{t(lang, 'ledger.caption')}</figcaption>
</figure>

<style>
  .ledger {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    box-shadow: 0 1px 0 var(--rule), 0 14px 32px -24px color-mix(in srgb, var(--ink) 55%, transparent);
  }
  .ledger__bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
  }
  .ledger__note {
    font-style: italic;
  }
  .ledger__rows {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
  }
  .ledger__rows li {
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr) 2.4rem;
    gap: 0.6rem;
    padding: 0.32rem 0.9rem;
    animation: ledger-in 420ms ease-out both;
    animation-delay: calc(var(--i) * 260ms + 200ms);
  }
  .ledger__op {
    color: var(--ai);
  }
  .ledger__detail {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .ledger__ok {
    color: var(--verified);
    text-align: right;
  }
  .ledger__done {
    margin: 0;
    padding: 0.7rem 0.9rem;
    border-top: 1px dashed var(--rule);
    color: var(--verified);
    font-weight: 600;
    animation: ledger-in 420ms ease-out both;
    animation-delay: calc(var(--i) * 260ms + 200ms);
  }
  .ledger figcaption {
    padding: 0 0.9rem 0.9rem;
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--muted);
  }
  /* Con movimiento reducido no hay animación ni retraso: todo visible desde el inicio. */
  @media (prefers-reduced-motion: reduce) {
    .ledger__rows li,
    .ledger__done {
      animation: none;
    }
  }
  @keyframes ledger-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }
</style>
