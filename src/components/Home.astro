---
import Evidence from './Evidence.astro';
import { t, localePath, type Locale } from '../i18n/ui';
import { projects, experience, education, skills, person, evidenceLabel } from '../data/profile';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const es = lang === 'es';
const caseHref = (slug: string) => localePath(lang, es ? `/casos/${slug}/` : `/cases/${slug}/`);
const featured = projects.find((p) => p.id === 'gymwarrior')!;
const others = projects.filter((p) => p.id !== 'gymwarrior');
const portfolioRepo = 'https://github.com/RenteriaH/RenteriaH.github.io';
const cvPdf = es ? '/cv/Guillermo_Renteria_CV_ES.pdf' : '/cv/Guillermo_Renteria_CV_EN.pdf';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero__text">
    <p class="eyebrow">{t(lang, 'hero.kicker')}</p>
    <h1 id="hero-title">{t(lang, 'hero.title')} <em>{t(lang, 'hero.titleEm')}</em></h1>
    <p class="hero__lede">{t(lang, 'hero.lede')}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="#trabajo">{t(lang, 'hero.ctaWork')}</a>
      <a class="btn" href={cvPdf}>{t(lang, 'hero.ctaCv')}</a>
    </div>
    <ul class="hero__links mono">
      <li><a href={person.github} rel="me">GitHub</a></li>
      <li><a href={person.linkedin} rel="me">LinkedIn</a></li>
      <li><a href={localePath(lang, '/cv/')}>{es ? 'Otras versiones del CV' : 'Other résumé versions'}</a></li>
    </ul>
  </div>
  <aside class="proof" aria-labelledby="proof-title">
    <h2 id="proof-title" class="proof__title mono">{t(lang, 'proof.title')}</h2>
    <dl>
      <div><dt>13/13</dt><dd><a href={caseHref('saneamiento-gymwarrior')}>{t(lang, 'proof.e2e')}</a></dd></div>
      <div><dt>100</dt><dd><a href={portfolioRepo}>{t(lang, 'proof.a11y')}</a></dd></div>
      <div><dt>2</dt><dd>{t(lang, 'proof.lang')}</dd></div>
    </dl>
    <p class="proof__note">{t(lang, 'proof.note')}</p>
  </aside>
</section>

<section class="section" id="trabajo" aria-labelledby="work-title">
  <div class="wrap">
    <h2 id="work-title">{t(lang, 'work.title')}</h2>
    <p class="muted work__intro">{t(lang, 'work.intro')}</p>

    <article class="feature" aria-labelledby="feature-title">
      <a class="feature__shot" href={caseHref(featured.caseSlug!)} tabindex="-1" aria-hidden="true">
        <img src="/img/gymwarrior/index.jpg" alt="" width="1280" height="800" loading="lazy" decoding="async" />
      </a>
      <div class="feature__body">
        <p class="eyebrow">{t(lang, 'work.featured')} · <Evidence lang={lang} kinds={featured.evidence} /></p>
        <h3 id="feature-title" class="feature__title"><a href={caseHref(featured.caseSlug!)}>{featured.title[lang]}</a></h3>
        <p class="feature__one">{featured.solution[lang]}</p>
        <dl class="feature__meta">
          <div><dt class="mono">{t(lang, 'work.myRole')}</dt><dd>{featured.role[lang]}</dd></div>
          <div><dt class="mono">Stack</dt><dd>{featured.stack.join(' · ')}</dd></div>
          <div><dt class="mono">{t(lang, 'work.status')}</dt><dd>{featured.facts[lang][0]}</dd></div>
        </dl>
        <p class="feature__cta"><a href={caseHref(featured.caseSlug!)}>{t(lang, 'work.readCase')} →</a>{featured.repo && <a href={featured.repo}>{t(lang, 'work.code')} →</a>}</p>
      </div>
    </article>

    <h3 class="index__title mono">{t(lang, 'work.others')}</h3>
    <ol class="index">
      {
        others.map((p, i) => (
          <li class="index__row">
            <span class="index__n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="index__main">
              <h4 id={`p-${p.id}`}>{p.title[lang]}</h4>
              <p>{p.oneLiner[lang]}</p>
              <details>
                <summary class="mono">{t(lang, 'work.details')}</summary>
                <dl class="project__dl">
                  <div><dt>{es ? 'Problema' : 'Problem'}</dt><dd>{p.problem[lang]}</dd></div>
                  <div><dt>{es ? 'Solución' : 'Solution'}</dt><dd>{p.solution[lang]}</dd></div>
                  <div><dt>{t(lang, 'work.myRole')}</dt><dd>{p.role[lang]}</dd></div>
                  <div><dt>{t(lang, 'work.status')}</dt><dd>{p.status[lang]}</dd></div>
                </dl>
                {p.facts[lang].length > 0 && <ul class="project__facts">{p.facts[lang].map((f) => <li>{f}</li>)}</ul>}
              </details>
            </div>
            <div class="index__side">
              <span class:list={['pill', { 'pill--public': p.public }]}>{p.public ? t(lang, 'work.public') : evidenceLabel[lang].private}</span>
              <span class="index__stack mono">{p.stack.slice(0, 3).join(' · ')}</span>
            </div>
            <div class="index__link">
              {p.public && p.repo ? <a href={p.repo}>{t(lang, 'work.code')} →</a> : <span class="mono muted">{t(lang, 'work.private')}</span>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="section" id="experiencia" aria-labelledby="exp-title">
  <div class="wrap section__grid">
    <p class="section__label">{t(lang, 'nav.experience')}</p>
    <div>
      <h2 id="exp-title">{t(lang, 'exp.title')}</h2>
      {
        experience.map((job) => (
          <article class="job">
            <p class="mono muted job__meta">
              {job.period[lang]} · {job.place[lang]}
            </p>
            <h3>
              {job.title[lang]} — {job.org}
            </h3>
            <ul class="job__list">
              {job.bullets[lang].map((b) => <li>{b}</li>)}
            </ul>
            <ul class="chips">
              {job.stack.map((s) => <li>{s}</li>)}
            </ul>
            {job.caseSlug && (
              <p class="job__case">
                <a href={caseHref(job.caseSlug)}>{t(lang, 'work.readCase')} →</a>
              </p>
            )}
          </article>
        ))
      }
      <h3 class="edu-title">{t(lang, 'edu.title')}</h3>
      <ul class="edu">
        {
          education.map((e) => (
            <li>
              <span class="edu__degree">{e.degree[lang]}</span>
              <span class="muted"> · {e.school}</span>
              <span class="mono muted edu__period">{e.period[lang]}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section class="section" id="tecnologias" aria-labelledby="skills-title">
  <div class="wrap section__grid">
    <p class="section__label">{t(lang, 'nav.skills')}</p>
    <div>
      <h2 id="skills-title">{t(lang, 'skills.title')}</h2>
      <p class="muted skills__intro">{t(lang, 'skills.intro')}</p>
      <div class="skills">
        {
          (['prod', 'proj', 'acad'] as const).map((k) => (
            <section class={`skills__group skills__group--${k}`} aria-labelledby={`sk-${k}`}>
              <h3 id={`sk-${k}`} class="mono">
                {t(lang, `skills.${k}`)}
              </h3>
              <ul class="chips">
                {skills[k].map((s) => <li>{s}</li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="section" id="sobre-mi" aria-labelledby="about-title">
  <div class="wrap section__grid">
    <p class="section__label">{t(lang, 'nav.about')}</p>
    <div class="prose">
      <h2 id="about-title">{t(lang, 'about.title')}</h2>
      {
        es ? (
          <>
            <p>
              Vivo en Torreón, Coahuila. Estudié el bachillerato técnico en Electrónica y ahora curso Ingeniería en Sistemas
              Computacionales en el Instituto Tecnológico de La Laguna, donde hago mi residencia profesional.
            </p>
            <p>
              Me interesa el trabajo que no se ve: que dos sistemas se entiendan, que un dato llegue completo, que un cambio en
              producción se pueda deshacer. En la residencia aprendí que el error casi nunca está donde aparece y que un número
              que nadie contó no es un dato.
            </p>
            <p>
              Trabajo mucho con agentes de IA y los trato como a un equipo que necesita reglas claras: permisos, verificación y
              alguien que revise. Estoy mejorando mi inglés.
            </p>
          </>
        ) : (
          <>
            <p>
              I live in Torreón, Coahuila, in northern Mexico. I completed a technical high-school program in Electronics and I’m
              now studying Computer Systems Engineering at Instituto Tecnológico de La Laguna, where I’m doing my professional internship.
            </p>
            <p>
              I care about the work nobody sees: two systems understanding each other, data arriving complete, a production
              change that can be undone. My internship taught me that the bug is rarely where it shows up, and that a number
              nobody counted isn’t data.
            </p>
            <p>
              I work a lot with AI agents and treat them like a team that needs clear rules: permits, verification and someone
              who reviews. I’m actively improving my English.
            </p>
          </>
        )
      }
    </div>
  </div>
</section>

<section class="section" id="contacto" aria-labelledby="contact-title">
  <div class="wrap section__grid">
    <p class="section__label">{t(lang, 'nav.contact')}</p>
    <div>
      <h2 id="contact-title">{t(lang, 'contact.title')}</h2>
      <p class="contact__text">{t(lang, 'contact.text')}</p>
      <ul class="contact__list">
        {person.email && (
          <li>
            <span class="mono muted">{es ? 'Correo' : 'Email'}</span> <span>{person.email}</span>
          </li>
        )}
        <li><span class="mono muted">LinkedIn</span> <a href={person.linkedin} rel="me">{decodeURI(person.linkedin).replace('https://www.', '')}</a></li>
        <li><span class="mono muted">GitHub</span> <a href={person.github} rel="me">{person.github.replace('https://', '')}</a></li>
        <li><span class="mono muted">CV</span> <a href={localePath(lang, '/cv/')}>{t(lang, 'cv.title')}</a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 2rem + 6vw, 7rem) clamp(3rem, 2rem + 4vw, 6rem);
    align-items: end;
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .hero h1 {
    margin: 1.25rem 0 1.5rem;
    max-width: 19ch;
  }
  .hero h1 em {
    color: var(--muted);
  }
  .hero__lede {
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 36rem;
    color: color-mix(in srgb, var(--ink) 82%, var(--ground));
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }
  .hero__links a {
    display: inline-block;
    padding-block: 0.6rem;
  }

  .proof {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }
  .proof__title {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .proof dl {
    display: grid;
    gap: 1rem;
    margin: 0;
  }
  .proof dl > div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: center;
  }
  .proof dt {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1;
    color: var(--accent);
  }
  .proof dd {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .proof dd a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .proof__note {
    margin: 1.25rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .work__intro {
    margin-bottom: 2.5rem;
  }
  .feature {
    display: grid;
    gap: 2rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 0.6rem + 2vw, 2.25rem);
  }
  @media (min-width: 56rem) {
    .feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 3rem;
      align-items: center;
    }
  }
  .feature__shot img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    transition: transform 0.35s ease;
  }
  .feature:hover .feature__shot img {
    transform: scale(1.01);
  }
  .feature .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .feature__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-2);
    line-height: 1.05;
    margin: 0.75rem 0 1rem;
  }
  .feature__title a {
    color: inherit;
    text-decoration: none;
  }
  .feature__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .feature__one {
    color: color-mix(in srgb, var(--ink) 82%, var(--ground));
  }
  .feature__meta {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
  }
  @media (min-width: 40rem) {
    .feature__meta {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .feature__meta dt {
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    font-size: 0.72rem;
  }
  .feature__meta dd {
    margin: 0.2rem 0 0;
  }
  .feature__cta {
    margin: 1.5rem 0 0;
    font-weight: 500;
  }

  .index__title {
    margin: 4rem 0 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 400;
    font-size: var(--step--1);
  }
  .index {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .index__row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--rule);
  }
  .index__row:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .index__side,
  .index__link {
    grid-column: 2;
  }
  @media (min-width: 52rem) {
    .index__row {
      grid-template-columns: 3rem minmax(0, 1fr) 14rem 8rem;
      align-items: baseline;
    }
    .index__side,
    .index__link {
      grid-column: auto;
    }
    .index__link {
      text-align: right;
    }
  }
  .index__n {
    color: var(--muted);
  }
  .index__main h4 {
    font-size: var(--step-1);
    font-weight: 500;
    margin: 0;
  }
  .index__main p {
    margin: 0.3rem 0 0;
    color: var(--muted);
    max-width: 52ch;
  }
  .index__main details {
    margin-top: 0.6rem;
  }
  .index__main summary {
    cursor: pointer;
    color: var(--link);
    padding-block: 0.35rem;
    width: fit-content;
  }
  .index__side {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .index__stack {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.05rem 0.55rem;
    color: var(--muted);
  }
  .pill--public {
    color: var(--verified);
    border-color: color-mix(in srgb, var(--verified) 45%, transparent);
  }
  .index__link a {
    display: inline-block;
    padding-block: 0.4rem;
    font-weight: 500;
  }

  .project__dl {
    display: grid;
    gap: 0.75rem 2rem;
    margin: 0.75rem 0;
  }
  @media (min-width: 46rem) {
    .project__dl {
      grid-template-columns: 1fr 1fr;
    }
  }
  .project__dl dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
  }
  .project__dl dd {
    margin: 0.15rem 0 0;
    font-size: var(--step--1);
    line-height: 1.55;
  }
  .project__facts {
    margin: 0;
    padding-left: 1.2em;
    font-size: var(--step--1);
  }

  .job + .job {
    margin-top: 2.5rem;
  }
  .job__meta {
    margin: 0 0 0.3rem;
  }
  .job__list {
    max-width: var(--measure);
    padding-left: 1.2em;
  }
  .job__list li + li {
    margin-top: 0.4em;
  }
  .job__case {
    margin-top: 1rem;
  }
  .edu-title {
    margin-top: 3rem;
  }
  .edu {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .edu li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .edu__degree {
    font-family: var(--font-ui);
    font-weight: 600;
  }
  .edu__period {
    margin-left: auto;
  }

  .skills__intro {
    max-width: var(--measure);
  }
  .skills {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .skills__group h3 {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.7rem;
  }
  .skills__group--prod h3 {
    color: var(--verified);
  }
  .skills__group--proj h3 {
    color: var(--ai);
  }
  .skills__group--acad h3 {
    color: var(--muted);
  }

  .contact__text {
    max-width: var(--measure);
  }
  .contact__list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  .contact__list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    align-items: baseline;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--rule);
  }
  .contact__list .mono {
    min-width: 5.5rem;
  }
  .contact__list a {
    overflow-wrap: anywhere;
  }
</style>
