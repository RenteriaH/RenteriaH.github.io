---
// Fuentes autoalojadas, solo el subconjunto latino (incluye español). Se precargan y usan
// font-display: optional para que nunca desplacen el contenido al cargar (CLS = 0).
import displayFont from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import monoFont from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import '../styles/global.css';
import { t, localePath, type Locale } from '../i18n/ui';
import { person } from '../data/profile';

interface Props {
  lang: Locale;
  /** Ruta sin prefijo de idioma, p. ej. "/" o "/casos/x/". */
  path: string;
  /** Ruta equivalente en el otro idioma, si difiere de `path`. */
  altPath?: string;
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Páginas sin equivalente ni indexación (404). */
  noindex?: boolean;
}

const { lang, path, altPath = path, title, description, type = 'website', noindex = false } = Astro.props;
const other: Locale = lang === 'es' ? 'en' : 'es';
const site = Astro.site ?? new URL('https://renteriah.github.io');
const fullTitle = title ? `${title} · ${person.shortName}` : t(lang, 'meta.title');
const desc = description ?? t(lang, 'meta.description');
const canonical = new URL(localePath(lang, path), site).href;
const alternate = new URL(localePath(other, altPath), site).href;
const esHref = lang === 'es' ? canonical : alternate;
const enHref = lang === 'en' ? canonical : alternate;
const ogImage = new URL('/og.png', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: lang === 'es' ? 'Desarrollador de software' : 'Software Developer',
  address: { '@type': 'PostalAddress', addressLocality: 'Torreón', addressRegion: 'Coahuila', addressCountry: 'MX' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Instituto Tecnológico de La Laguna' },
  url: new URL(localePath(lang, '/'), site).href,
  sameAs: [person.github, person.linkedin],
};

const nav = [
  { href: `${localePath(lang, '/')}#trabajo`, label: t(lang, 'nav.work') },
  { href: `${localePath(lang, '/')}#experiencia`, label: t(lang, 'nav.experience') },
  { href: `${localePath(lang, '/')}#tecnologias`, label: t(lang, 'nav.skills') },
  { href: localePath(lang, '/cv/'), label: t(lang, 'nav.cv') },
  { href: `${localePath(lang, '/')}#contacto`, label: t(lang, 'nav.contact') },
];
---

<html lang={lang === 'es' ? 'es-MX' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="alternate" hreflang="es-MX" href={esHref} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enHref} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={esHref} />}
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <style
      is:inline
      set:html={`@font-face{font-family:'Schibsted Grotesk Variable';font-style:normal;font-weight:400 900;font-display:optional;src:url(${displayFont}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Source Serif 4 Variable';font-style:normal;font-weight:200 900;font-display:optional;src:url(${bodyFont}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:400;font-display:optional;src:url(${monoFont}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#eef2f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d141b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'nav.skip')}</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={localePath(lang, '/')}>{person.shortName}</a>
        <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            <li>
              <a href={localePath(other, altPath)} hreflang={other} lang={other} aria-label={t(lang, 'nav.switchLabel')}>
                {t(lang, 'nav.switch')}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p class="mono muted">© 2026 {person.name}</p>
        <p class="mono muted">{t(lang, 'footer.built')}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    padding-top: env(safe-area-inset-top, 0px);
    border-bottom: 1px solid var(--rule);
    background: var(--ground);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.9rem;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    padding-block: 0.55rem;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 560;
    color: var(--ink);
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
  }
  nav li:last-child a {
    color: var(--link);
  }
  main:focus {
    outline: none;
  }
  .site-footer {
    border-top: 1px solid var(--rule);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 2rem;
    padding-block: 1.5rem;
  }
  .site-footer p {
    margin: 0;
  }
</style>
