---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseStudy from '../../components/CaseStudy.astro';

export async function getStaticPaths() {
  const entries = await getCollection('cases', (e) => e.filePath?.includes('/cases/es/') ?? false);
  return entries.map((entry) => ({ params: { slug: entry.data.key }, props: { entry } }));
}
const { entry } = Astro.props;
const slug = entry.data.key;
---

<Base lang="es" path={`/casos/${slug}/`} altPath={`/cases/${slug}/`} title={entry.data.seoTitle} description={entry.data.seoDescription} type="article">
  <CaseStudy lang="es" entry={entry} />
</Base>
